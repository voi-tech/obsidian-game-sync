{
	"name": "obsidian-game-sync",
	"version": "26.10.0",
	"description": "Sync GameTrack exports, Steam and PlayStation game libraries, playtime and achievements into ordinary Obsidian Markdown notes.",
	"author": "voitech",
	"license": "MIT",
	"main": "main.js",
	"homepage": "https://github.com/voi-tech/obsidian-game-sync#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voi-tech/obsidian-game-sync.git"
	},
	"bugs": {
		"url": "https://github.com/voi-tech/obsidian-game-sync/issues"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs --watch",
		"build": "node esbuild.config.mjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint . --max-warnings=0",
		"check:mobile-bundle": "node scripts/check-mobile-bundle.mjs",
		"release:check": "node scripts/check-release.mjs",
		"check": "npm run lint && npm run typecheck && npm test && npm run build && npm run release:check",
		"version": "node scripts/version-bump.mjs"
	},
	"dependencies": {
		"handlebars": "^4.7.9",
		"psn-api": "^2.18.1",
		"yaml": "^2.9.1",
		"zod": "^4.6.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.20.2",
		"builtin-modules": "^5.3.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.10.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.12.0",
		"jsdom": "26.1.0",
		"obsidian": "^1.13.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0",
		"vitest": "4.1.11"
	}
}
